{
  "name": "zenx-go",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy": "bash scripts/deploy.sh",
    "start": "node scripts/start.mjs",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "pnpm --filter api test:integration",
    "test:e2e": "pnpm --filter api test:db:prepare && pnpm --filter api test:db:reset && cross-env NEXT_DIST_DIR=.next-e2e NEXT_PUBLIC_API_BASE_URL=/api/v1 API_PROXY_ORIGIN=http://127.0.0.1:4300 PUBLIC_BASE_DOMAIN=lvh.me PUBLIC_WEB_ORIGIN=http://lvh.me:3300 pnpm build && turbo test:e2e",
    "test:db:prepare": "pnpm --filter api test:db:prepare",
    "test:db:reset": "pnpm --filter api test:db:reset",
    "db:wait": "docker compose up -d --wait sqlserver",
    "db:migrate": "pnpm db:wait && pnpm --filter api prisma:deploy",
    "db:seed": "pnpm db:wait && pnpm --filter api prisma:seed",
    "db:generate": "pnpm --filter api prisma:generate",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "cross-env": "^10.0.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
