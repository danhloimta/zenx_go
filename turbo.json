{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": ["NEXT_DIST_DIR", "NEXT_PUBLIC_API_BASE_URL", "NEXT_PUBLIC_BASE_DOMAIN", "NEXT_PUBLIC_WEB_ORIGIN", "PUBLIC_BASE_DOMAIN", "PUBLIC_WEB_ORIGIN", "API_PROXY_ORIGIN", "NEXT_TELEMETRY_DISABLED"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "API_PORT",
        "COOKIE_DOMAIN",
        "COOKIE_SECURE",
        "DATABASE_URL",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXT_DIST_DIR",
        "NEXT_TELEMETRY_DISABLED",
        "NODE_ENV",
        "DEMO_MODE",
        "OTP_EMAIL_PROVIDER",
        "OTP_MOCK_FIXED_CODE",
        "OTP_SMS_PROVIDER",
        "OTP_ZALO_PROVIDER",
        "PAYMENT_PROVIDER",
        "SEPAY_BANK_ACCOUNT",
        "SEPAY_BANK_CODE",
        "SEPAY_ACCOUNT_HOLDER",
        "SEPAY_WEBHOOK_SECRET",
        "SEPAY_TRANSFER_PREFIX",
        "SEPAY_QR_BASE_URL",
        "OAUTH_STATE_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REDIRECT_URI",
        "GOOGLE_AUTHORIZATION_URL",
        "GOOGLE_TOKEN_URL",
        "GOOGLE_USERINFO_URL",
        "FACEBOOK_CLIENT_ID",
        "FACEBOOK_CLIENT_SECRET",
        "FACEBOOK_REDIRECT_URI",
        "FACEBOOK_AUTHORIZATION_URL",
        "FACEBOOK_TOKEN_URL",
        "FACEBOOK_USERINFO_URL",
        "PORT",
        "PRIVACY_VERSION",
        "SKIP_DB_CONNECT",
        "TERMS_VERSION",
        "UPLOAD_DIR",
        "RATE_LIMIT_TTL_MS",
        "RATE_LIMIT_MAX",
        "WEB_ORIGIN",
        "PUBLIC_BASE_DOMAIN",
        "PUBLIC_WEB_ORIGIN",
        "ALLOWED_WEB_ORIGINS",
        "ALLOW_GAME_SUBDOMAINS",
        "GAME_DEMO_PUBLIC",
        "ALLOW_TEST_OAUTH",
        "API_PROXY_ORIGIN"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "env": [
        "API_PORT",
        "COOKIE_DOMAIN",
        "COOKIE_SECURE",
        "DATABASE_URL",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXT_TELEMETRY_DISABLED",
        "NODE_ENV",
        "DEMO_MODE",
        "OTP_EMAIL_PROVIDER",
        "OTP_MOCK_FIXED_CODE",
        "OTP_SMS_PROVIDER",
        "OTP_ZALO_PROVIDER",
        "PAYMENT_PROVIDER",
        "SEPAY_BANK_ACCOUNT",
        "SEPAY_BANK_CODE",
        "SEPAY_ACCOUNT_HOLDER",
        "SEPAY_WEBHOOK_SECRET",
        "SEPAY_TRANSFER_PREFIX",
        "SEPAY_QR_BASE_URL",
        "OAUTH_STATE_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REDIRECT_URI",
        "GOOGLE_AUTHORIZATION_URL",
        "GOOGLE_TOKEN_URL",
        "GOOGLE_USERINFO_URL",
        "FACEBOOK_CLIENT_ID",
        "FACEBOOK_CLIENT_SECRET",
        "FACEBOOK_REDIRECT_URI",
        "FACEBOOK_AUTHORIZATION_URL",
        "FACEBOOK_TOKEN_URL",
        "FACEBOOK_USERINFO_URL",
        "PORT",
        "PRIVACY_VERSION",
        "SKIP_DB_CONNECT",
        "TERMS_VERSION",
        "UPLOAD_DIR",
        "WEB_ORIGIN",
        "PUBLIC_BASE_DOMAIN",
        "PUBLIC_WEB_ORIGIN",
        "ALLOWED_WEB_ORIGINS",
        "ALLOW_GAME_SUBDOMAINS",
        "GAME_DEMO_PUBLIC",
        "ALLOW_TEST_OAUTH",
        "API_PROXY_ORIGIN"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false
    }
  }
}
