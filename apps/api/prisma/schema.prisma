generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model AuthSettings {
  id                               Int      @id @default(1)
  googleLoginRegistrationEnabled   Boolean  @default(true) @map("google_login_registration_enabled")
  facebookLoginRegistrationEnabled Boolean  @default(true) @map("facebook_login_registration_enabled")
  phoneRegistrationOtpRequired     Boolean  @default(true) @map("phone_registration_otp_required")
  updatedAt                        DateTime @updatedAt @map("updated_at")

  @@map("auth_settings")
}

model User {
  id                     String                   @id @default(uuid()) @db.UniqueIdentifier
  username               String                   @db.NVarChar(64)
  usernameNormalized     String                   @unique @map("username_normalized") @db.NVarChar(64)
  email                  String                   @db.NVarChar(320)
  emailNormalized        String                   @unique @map("email_normalized") @db.NVarChar(320)
  phone                  String?                  @db.NVarChar(32)
  phoneNormalized        String?                  @unique @map("phone_normalized") @db.NVarChar(32)
  passwordHash           String?                  @map("password_hash") @db.NVarChar(255)
  status                 String                   @default("PENDING") @db.VarChar(16)
  authVersion            Int                      @default(0) @map("auth_version")
  mustChangePassword     Boolean                  @default(false) @map("must_change_password")
  phoneVerifiedAt        DateTime?                @map("phone_verified_at")
  emailVerifiedAt        DateTime?                @map("email_verified_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  profile                UserProfile?
  socialIdentities       SocialIdentity[]
  wallet                 Wallet?
  payments               Payment[]
  walletTransactions     WalletTransaction[]
  refreshSessions        RefreshSession[]
  otpRequests            OtpRequest[]
  supportTickets         SupportTicket[]          @relation("SupportTicketOwner")
  sensitiveProfile       SensitiveProfile?
  roles                  UserRole[]
  assignedRoleChanges    UserRole[]               @relation("UserRoleAssignedBy")
  authorizationAuditLogs AuthorizationAuditLog[]  @relation("AuthorizationAuditActor")
  gameRoleAssignments   GameRoleAssignment[]     @relation("GameRoleAssignmentUser")
  assignedGameRoles     GameRoleAssignment[]     @relation("GameRoleAssignmentAssignedBy")
  gamePlayers           GamePlayer[]             @relation("GamePlayerUser")
  blockedGamePlayers    GamePlayer[]             @relation("GamePlayerBlockedBy")
  gameSsoCodes          GameSsoAuthorizationCode[]
  assignedSupportTickets SupportTicket[]          @relation("SupportTicketAssignee")
  supportMessages        SupportTicketMessage[]   @relation("SupportMessageAuthor")
  supportReadStates      SupportTicketReadState[] @relation("SupportReadUser")

  @@index([status])
  @@map("users")
}

model UserRole {
  id               String   @id @default(uuid()) @db.UniqueIdentifier
  userId           String   @map("user_id") @db.UniqueIdentifier
  roleId           String   @map("role_id") @db.UniqueIdentifier
  assignedByUserId String?  @map("assigned_by_user_id") @db.UniqueIdentifier
  assignedAt       DateTime @default(now()) @map("assigned_at")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedBy       User?    @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, roleId])
  @@index([roleId, userId])
  @@map("user_roles")
}

model Role {
  id          String           @id @default(uuid()) @db.UniqueIdentifier
  code        String           @unique @db.VarChar(32)
  name        String           @db.NVarChar(120)
  description String?          @db.NVarChar(500)
  isSystem    Boolean          @default(false) @map("is_system")
  isActive    Boolean          @default(true) @map("is_active")
  scopeType   String           @default("PLATFORM") @map("scope_type") @db.VarChar(16)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]
  gameAssignments GameRoleAssignment[]

  @@index([isActive, code])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.UniqueIdentifier
  code        String           @unique @db.VarChar(64)
  module      String           @db.VarChar(32)
  action      String           @db.VarChar(48)
  subject     String           @db.VarChar(48)
  name        String           @db.NVarChar(160)
  description String?          @db.NVarChar(500)
  sortOrder   Int              @default(0) @map("sort_order")
  isActive    Boolean          @default(true) @map("is_active")
  scopeType   String           @default("PLATFORM") @map("scope_type") @db.VarChar(16)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@unique([action, subject])
  @@index([module, sortOrder])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.UniqueIdentifier
  permissionId String     @map("permission_id") @db.UniqueIdentifier
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId, roleId])
  @@map("role_permissions")
}

model AuthorizationAuditLog {
  id          String    @id @default(uuid()) @db.UniqueIdentifier
  actorUserId String?   @map("actor_user_id") @db.UniqueIdentifier
  action      String    @db.VarChar(64)
  targetType  String    @map("target_type") @db.VarChar(32)
  targetId    String?   @map("target_id") @db.UniqueIdentifier
  gameId      String?   @map("game_id") @db.UniqueIdentifier
  beforeData  String?   @map("before_data") @db.NVarChar(Max)
  afterData   String?   @map("after_data") @db.NVarChar(Max)
  reason      String?   @db.NVarChar(500)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.NVarChar(512)
  createdAt   DateTime  @default(now()) @map("created_at")
  actor       User?     @relation("AuthorizationAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  game        Game?     @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([gameId, createdAt])
  @@map("authorization_audit_logs")
}

model Game {
  id                String          @id @default(uuid()) @db.UniqueIdentifier
  code              String          @unique @db.VarChar(32)
  name              String          @db.NVarChar(160)
  slug              String          @unique @db.VarChar(160)
  subdomain         String          @unique @db.VarChar(63)
  recordType        String          @map("record_type") @db.VarChar(16)
  tagline           String          @db.NVarChar(500)
  shortDescription  String          @map("short_description") @db.NVarChar(1000)
  longDescription   String?         @map("long_description") @db.NVarChar(Max)
  lifecycleStatus   String          @map("lifecycle_status") @db.VarChar(24)
  operationalStatus String          @default("AVAILABLE") @map("operational_status") @db.VarChar(24)
  releaseYear       Int?            @map("release_year")
  themePreset       String          @map("theme_preset") @db.VarChar(40)
  templateVersion   Int             @default(1) @map("template_version")
  themeConfig       String          @map("theme_config") @db.NVarChar(Max)
  featureConfig     String          @map("feature_config") @db.NVarChar(Max)
  pageConfig        String          @map("page_config") @db.NVarChar(Max)
  logoUrl           String?         @map("logo_url") @db.NVarChar(2048)
  iconUrl           String?         @map("icon_url") @db.NVarChar(2048)
  coverUrl          String?         @map("cover_url") @db.NVarChar(2048)
  heroDesktopUrl    String?         @map("hero_desktop_url") @db.NVarChar(2048)
  heroMobileUrl     String?         @map("hero_mobile_url") @db.NVarChar(2048)
  primaryCtaLabel   String?         @map("primary_cta_label") @db.NVarChar(80)
  primaryCtaPath    String?         @map("primary_cta_path") @db.NVarChar(2048)
  secondaryCtaLabel String?         @map("secondary_cta_label") @db.NVarChar(80)
  secondaryCtaPath  String?         @map("secondary_cta_path") @db.NVarChar(2048)
  featured          Boolean         @default(false)
  primaryGame       Boolean         @default(false) @map("primary_game")
  isPublic          Boolean         @default(false) @map("is_public")
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  genres            GameGenre[]
  platforms         GamePlatform[]
  articles          GameArticle[]
  milestones        GameMilestone[]
  events            GameEvent[]
  roleAssignments   GameRoleAssignment[]
  players           GamePlayer[]
  ssoClient         GameSsoClient?
  ssoCodes          GameSsoAuthorizationCode[]
  authorizationAuditLogs AuthorizationAuditLog[]

  @@index([isPublic, sortOrder])
  @@index([subdomain, isPublic])
  @@index([lifecycleStatus, isPublic])
  @@map("games")
}

model GameRoleAssignment {
  id               String   @id @default(uuid()) @db.UniqueIdentifier
  userId           String   @map("user_id") @db.UniqueIdentifier
  gameId           String   @map("game_id") @db.UniqueIdentifier
  roleId           String   @map("role_id") @db.UniqueIdentifier
  assignedByUserId String?  @map("assigned_by_user_id") @db.UniqueIdentifier
  assignedAt       DateTime @default(now()) @map("assigned_at")
  user             User     @relation("GameRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  game             Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy       User?    @relation("GameRoleAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, gameId, roleId])
  @@index([gameId, userId])
  @@index([roleId, userId])
  @@map("game_role_assignments")
}

model GamePlayer {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  userId          String   @map("user_id") @db.UniqueIdentifier
  gameId          String   @map("game_id") @db.UniqueIdentifier
  status          String   @default("ACTIVE") @db.VarChar(16)
  firstLoginAt    DateTime @default(now()) @map("first_login_at")
  lastLoginAt     DateTime @default(now()) @map("last_login_at")
  loginCount      Int      @default(1) @map("login_count")
  blockedAt       DateTime? @map("blocked_at")
  blockedByUserId String?  @map("blocked_by_user_id") @db.UniqueIdentifier
  blockReason     String?  @map("block_reason") @db.NVarChar(500)
  supportNote     String?  @map("support_note") @db.NVarChar(2000)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation("GamePlayerUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  blockedBy       User?    @relation("GamePlayerBlockedBy", fields: [blockedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([userId, gameId])
  @@index([gameId, lastLoginAt])
  @@index([gameId, status, lastLoginAt])
  @@map("game_players")
}

model GameSsoClient {
  id               String   @id @default(uuid()) @db.UniqueIdentifier
  gameId           String   @unique @map("game_id") @db.UniqueIdentifier
  clientId         String   @unique @map("client_id") @db.VarChar(96)
  clientSecretHash String   @map("client_secret_hash") @db.NVarChar(255)
  redirectUri      String   @map("redirect_uri") @db.NVarChar(2048)
  isActive         Boolean  @default(false) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  game             Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  authorizationCodes GameSsoAuthorizationCode[]

  @@map("game_sso_clients")
}

model GameSsoAuthorizationCode {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  codeHash     String   @unique @map("code_hash") @db.Char(64)
  clientId     String   @map("client_id") @db.UniqueIdentifier
  userId       String   @map("user_id") @db.UniqueIdentifier
  gameId       String   @map("game_id") @db.UniqueIdentifier
  redirectUri  String   @map("redirect_uri") @db.NVarChar(2048)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  client       GameSsoClient @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([expiresAt])
  @@map("game_sso_authorization_codes")
}

model Genre {
  id        String      @id @default(uuid()) @db.UniqueIdentifier
  code      String      @unique @db.VarChar(32)
  name      String      @db.NVarChar(80)
  slug      String      @unique @db.VarChar(80)
  sortOrder Int         @default(0) @map("sort_order")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  games     GameGenre[]

  @@index([isActive, sortOrder])
  @@map("genres")
}

model GameGenre {
  gameId  String @map("game_id") @db.UniqueIdentifier
  genreId String @map("genre_id") @db.UniqueIdentifier
  game    Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([gameId, genreId])
  @@index([genreId, gameId])
  @@map("game_genres")
}

model GamePlatform {
  id       String @id @default(uuid()) @db.UniqueIdentifier
  gameId   String @map("game_id") @db.UniqueIdentifier
  platform String @db.VarChar(24)
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, platform])
  @@index([platform, gameId])
  @@map("game_platforms")
}

model GameArticle {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  gameId         String    @map("game_id") @db.UniqueIdentifier
  title          String    @db.NVarChar(240)
  slug           String    @db.VarChar(180)
  excerpt        String    @db.NVarChar(1000)
  content        String    @db.NVarChar(Max)
  coverImageUrl  String?   @map("cover_image_url") @db.NVarChar(2048)
  category       String    @db.VarChar(32)
  status         String    @default("PUBLISHED") @db.VarChar(16)
  publishedAt    DateTime? @map("published_at")
  seoTitle       String?   @map("seo_title") @db.NVarChar(240)
  seoDescription String?   @map("seo_description") @db.NVarChar(500)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  game           Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, slug])
  @@index([gameId, status, publishedAt])
  @@index([deletedAt])
  @@map("game_articles")
}

model GameMilestone {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  gameId          String   @map("game_id") @db.UniqueIdentifier
  title           String   @db.NVarChar(240)
  description     String?  @db.NVarChar(1000)
  displayPeriod   String   @map("display_period") @db.NVarChar(80)
  status          String   @db.VarChar(24)
  checklistConfig String   @map("checklist_config") @db.NVarChar(Max)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, sortOrder])
  @@map("game_milestones")
}

model PortalAnnouncement {
  id        String    @id @default(uuid()) @db.UniqueIdentifier
  code      String    @unique @db.VarChar(64)
  title     String    @db.NVarChar(160)
  message   String    @db.NVarChar(500)
  ctaLabel  String?   @map("cta_label") @db.NVarChar(80)
  ctaPath   String?   @map("cta_path") @db.NVarChar(2048)
  status    String    @default("PUBLISHED") @db.VarChar(16)
  startsAt  DateTime  @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status, startsAt, endsAt])
  @@map("portal_announcements")
}

model GameEvent {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  gameId         String?   @map("game_id") @db.UniqueIdentifier
  title          String    @db.NVarChar(240)
  slug           String    @unique @db.VarChar(180)
  excerpt        String    @db.NVarChar(1000)
  content        String    @db.NVarChar(Max)
  coverImageUrl  String?   @map("cover_image_url") @db.NVarChar(2048)
  status         String    @default("PUBLISHED") @db.VarChar(16)
  startsAt       DateTime  @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  publishedAt    DateTime? @map("published_at")
  seoTitle       String?   @map("seo_title") @db.NVarChar(240)
  seoDescription String?   @map("seo_description") @db.NVarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  game           Game?     @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([gameId, status, publishedAt])
  @@index([status, startsAt, endsAt])
  @@map("game_events")
}

model UserProfile {
  id                 String    @id @default(uuid()) @db.UniqueIdentifier
  userId             String    @unique @map("user_id") @db.UniqueIdentifier
  fullName           String    @map("full_name") @db.NVarChar(160)
  avatarUrl          String?   @map("avatar_url") @db.NVarChar(2048)
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  gender             String    @default("UNSPECIFIED") @db.VarChar(16)
  city               String?   @db.NVarChar(120)
  address            String?   @db.NVarChar(255)
  profileCompletedAt DateTime? @map("profile_completed_at")
  termsVersion       String    @map("terms_version") @db.NVarChar(32)
  privacyVersion     String    @map("privacy_version") @db.NVarChar(32)
  acceptedAt         DateTime  @map("accepted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model SensitiveProfile {
  id                   String    @id @default(uuid()) @db.UniqueIdentifier
  userId               String    @unique @map("user_id") @db.UniqueIdentifier
  citizenIdCiphertext  String?   @map("citizen_id_ciphertext") @db.NVarChar(2048)
  citizenIdIv          String?   @map("citizen_id_iv") @db.VarChar(32)
  citizenIdAuthTag     String?   @map("citizen_id_auth_tag") @db.VarChar(32)
  citizenIdLookupHash  String?   @map("citizen_id_lookup_hash") @db.Char(64)
  citizenIdLast4       String?   @map("citizen_id_last4") @db.Char(4)
  secretCodeHash       String?   @map("secret_code_hash") @db.NVarChar(255)
  securityQuestionCode String?   @map("security_question_code") @db.VarChar(40)
  securityAnswerHash   String?   @map("security_answer_hash") @db.NVarChar(255)
  securityVersion      Int       @default(0) @map("security_version")
  failedChallengeCount Int       @default(0) @map("failed_challenge_count")
  challengeLockedUntil DateTime? @map("challenge_locked_until")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sensitive_profiles")
}

model SecurityQuestion {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  code      String   @unique @db.VarChar(40)
  label     String   @db.NVarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("security_questions")
}

model SocialIdentity {
  id              String    @id @default(uuid()) @db.UniqueIdentifier
  userId          String    @map("user_id") @db.UniqueIdentifier
  provider        String    @db.VarChar(16)
  providerUserId  String    @map("provider_user_id") @db.NVarChar(255)
  emailAtLinkTime String?   @map("email_at_link_time") @db.NVarChar(320)
  linkedAt        DateTime  @default(now()) @map("linked_at")
  lastLoginAt     DateTime? @map("last_login_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_identities")
}

model OtpRequest {
  id                    String            @id @default(uuid()) @db.UniqueIdentifier
  userId                String?           @map("user_id") @db.UniqueIdentifier
  channel               String            @db.VarChar(16)
  purpose               String            @db.VarChar(32)
  destination           String            @db.NVarChar(320)
  destinationNormalized String            @map("destination_normalized") @db.NVarChar(320)
  codeHash              String            @map("code_hash") @db.NVarChar(255)
  status                String            @default("PENDING") @db.VarChar(16)
  attemptCount          Int               @default(0) @map("attempt_count")
  expiresAt             DateTime          @map("expires_at")
  resendAfter           DateTime          @map("resend_after")
  usedAt                DateTime?         @map("used_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  verifications         OtpVerification[]

  @@index([destinationNormalized, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@map("otp_requests")
}

model OtpVerification {
  id           String     @id @default(uuid()) @db.UniqueIdentifier
  otpRequestId String     @map("otp_request_id") @db.UniqueIdentifier
  tokenHash    String     @unique @map("token_hash") @db.NVarChar(255)
  purpose      String     @db.VarChar(32)
  expiresAt    DateTime   @map("expires_at")
  consumedAt   DateTime?  @map("consumed_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  otpRequest   OtpRequest @relation(fields: [otpRequestId], references: [id], onDelete: Cascade)

  @@index([purpose, expiresAt])
  @@map("otp_verifications")
}

model RefreshSession {
  id           String    @id @default(uuid()) @db.UniqueIdentifier
  userId       String    @map("user_id") @db.UniqueIdentifier
  tokenHash    String    @unique @map("token_hash") @db.NVarChar(255)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.UniqueIdentifier
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_sessions")
}

model Wallet {
  id           String              @id @default(uuid()) @db.UniqueIdentifier
  userId       String              @unique @map("user_id") @db.UniqueIdentifier
  currency     String              @default("ZENX") @db.VarChar(16)
  balance      BigInt              @default(0)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  transactionNo  String    @unique @map("transaction_no") @db.VarChar(40)
  walletId       String    @map("wallet_id") @db.UniqueIdentifier
  userId         String    @map("user_id") @db.UniqueIdentifier
  paymentId      String?   @map("payment_id") @db.UniqueIdentifier
  type           String    @db.VarChar(16)
  amount         BigInt
  balanceBefore  BigInt    @map("balance_before")
  balanceAfter   BigInt    @map("balance_after")
  status         String    @default("SUCCESS") @db.VarChar(16)
  referenceType  String    @map("reference_type") @db.VarChar(64)
  referenceId    String    @map("reference_id") @db.VarChar(255)
  idempotencyKey String    @default(uuid()) @map("idempotency_key") @db.VarChar(255)
  description    String?   @db.NVarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")
  wallet         Wallet    @relation(fields: [walletId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment        Payment?  @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@unique([userId, idempotencyKey])
  @@map("wallet_transactions")
}

model CoinPackage {
  id         String    @id @default(uuid()) @db.UniqueIdentifier
  code       String    @unique @db.VarChar(32)
  name       String    @db.NVarChar(120)
  priceVnd   BigInt    @map("price_vnd")
  coinAmount BigInt    @map("coin_amount")
  status     String    @default("ACTIVE") @db.VarChar(16)
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  payments   Payment[]

  @@index([status, sortOrder])
  @@map("coin_packages")
}

model Payment {
  id                    String              @id @default(uuid()) @db.UniqueIdentifier
  paymentNo             String              @unique @map("payment_no") @db.VarChar(40)
  userId                String              @map("user_id") @db.UniqueIdentifier
  coinPackageId         String              @map("coin_package_id") @db.UniqueIdentifier
  amountVnd             BigInt              @map("amount_vnd")
  coinAmount            BigInt              @map("coin_amount")
  provider              String              @db.VarChar(64)
  paymentMethod         String              @map("payment_method") @db.VarChar(32)
  providerTransactionId String?             @map("provider_transaction_id") @db.VarChar(255)
  idempotencyKey        String?             @map("idempotency_key") @db.VarChar(255)
  providerPayload       String?             @map("provider_payload") @db.NVarChar(4000)
  status                String              @default("CREATED") @db.VarChar(16)
  createdAt             DateTime            @default(now()) @map("created_at")
  paidAt                DateTime?           @map("paid_at")
  expiredAt             DateTime?           @map("expired_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  user                  User                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coinPackage           CoinPackage         @relation(fields: [coinPackageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  walletTransactions    WalletTransaction[]

  @@index([userId, createdAt])
  @@index([userId, idempotencyKey])
  @@index([status, createdAt])
  @@map("payments")
}

model SupportCategory {
  id        String          @id @default(uuid()) @db.UniqueIdentifier
  code      String          @unique @db.VarChar(32)
  name      String          @db.NVarChar(80)
  status    String          @default("ACTIVE") @db.VarChar(16)
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  faqs      SupportFaq[]
  tickets   SupportTicket[]

  @@index([status, sortOrder])
  @@map("support_categories")
}

model SupportFaq {
  id         String          @id @default(uuid()) @db.UniqueIdentifier
  categoryId String          @map("category_id") @db.UniqueIdentifier
  question   String          @db.NVarChar(500)
  answer     String          @db.NVarChar(4000)
  status     String          @default("ACTIVE") @db.VarChar(16)
  sortOrder  Int             @default(0) @map("sort_order")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  category   SupportCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, question])
  @@index([categoryId, status, sortOrder])
  @@map("support_faqs")
}

model SupportTicket {
  id                    String                   @id @default(uuid()) @db.UniqueIdentifier
  ticketNo              String                   @unique @map("ticket_no") @db.VarChar(40)
  userId                String                   @map("user_id") @db.UniqueIdentifier
  categoryId            String                   @map("category_id") @db.UniqueIdentifier
  subject               String                   @db.NVarChar(160)
  description           String                   @db.NVarChar(4000)
  status                String                   @default("NEW") @db.VarChar(16)
  priority              String                   @default("NORMAL") @db.VarChar(16)
  assigneeUserId        String?                  @map("assignee_user_id") @db.UniqueIdentifier
  lastActivityAt        DateTime                 @default(now()) @map("last_activity_at")
  lastCustomerMessageAt DateTime?                @map("last_customer_message_at")
  lastStaffReplyAt      DateTime?                @map("last_staff_reply_at")
  resolvedAt            DateTime?                @map("resolved_at")
  closedAt              DateTime?                @map("closed_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  user                  User                     @relation("SupportTicketOwner", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee              User?                    @relation("SupportTicketAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  category              SupportCategory          @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages              SupportTicketMessage[]
  readStates            SupportTicketReadState[]

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([status, priority, lastActivityAt])
  @@index([assigneeUserId, status, lastActivityAt])
  @@index([lastActivityAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String        @id @default(uuid()) @db.UniqueIdentifier
  ticketId     String        @map("ticket_id") @db.UniqueIdentifier
  authorUserId String        @map("author_user_id") @db.UniqueIdentifier
  authorType   String        @map("author_type") @db.VarChar(16)
  visibility   String        @db.VarChar(16)
  body         String        @db.NVarChar(4000)
  createdAt    DateTime      @default(now()) @map("created_at")
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author       User          @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ticketId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("support_ticket_messages")
}

model SupportTicketReadState {
  ticketId   String        @map("ticket_id") @db.UniqueIdentifier
  userId     String        @map("user_id") @db.UniqueIdentifier
  lastReadAt DateTime      @map("last_read_at")
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User          @relation("SupportReadUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([ticketId, userId])
  @@index([userId, lastReadAt])
  @@map("support_ticket_read_states")
}
