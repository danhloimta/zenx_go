generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(uuid()) @db.UniqueIdentifier
  username           String             @db.NVarChar(64)
  usernameNormalized String             @unique @map("username_normalized") @db.NVarChar(64)
  email              String             @db.NVarChar(320)
  emailNormalized    String             @unique @map("email_normalized") @db.NVarChar(320)
  phone              String             @db.NVarChar(32)
  phoneNormalized    String             @unique @map("phone_normalized") @db.NVarChar(32)
  passwordHash       String?            @map("password_hash") @db.NVarChar(255)
  status             String             @default("PENDING") @db.VarChar(16)
  phoneVerifiedAt   DateTime?          @map("phone_verified_at")
  emailVerifiedAt   DateTime?          @map("email_verified_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  profile            UserProfile?
  socialIdentities   SocialIdentity[]
  wallet             Wallet?
  payments           Payment[]
  walletTransactions WalletTransaction[]
  refreshSessions    RefreshSession[]
  otpRequests        OtpRequest[]

  @@index([status])
  @@map("users")
}

model UserProfile {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  userId         String    @unique @map("user_id") @db.UniqueIdentifier
  fullName       String    @map("full_name") @db.NVarChar(160)
  avatarUrl      String?   @map("avatar_url") @db.NVarChar(2048)
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  gender         String    @default("UNSPECIFIED") @db.VarChar(16)
  city           String?   @db.NVarChar(120)
  address        String?   @db.NVarChar(255)
  profileCompletedAt DateTime? @map("profile_completed_at")
  termsVersion   String    @map("terms_version") @db.NVarChar(32)
  privacyVersion String    @map("privacy_version") @db.NVarChar(32)
  acceptedAt     DateTime  @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model SocialIdentity {
  id              String         @id @default(uuid()) @db.UniqueIdentifier
  userId          String         @map("user_id") @db.UniqueIdentifier
  provider        String         @db.VarChar(16)
  providerUserId  String         @map("provider_user_id") @db.NVarChar(255)
  emailAtLinkTime String?        @map("email_at_link_time") @db.NVarChar(320)
  linkedAt        DateTime       @default(now()) @map("linked_at")
  lastLoginAt     DateTime?      @map("last_login_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_identities")
}

model OtpRequest {
  id            String      @id @default(uuid()) @db.UniqueIdentifier
  userId        String?     @map("user_id") @db.UniqueIdentifier
  channel       String      @db.VarChar(16)
  purpose       String      @db.VarChar(32)
  destination   String      @db.NVarChar(320)
  destinationNormalized String @map("destination_normalized") @db.NVarChar(320)
  codeHash      String      @map("code_hash") @db.NVarChar(255)
  status        String      @default("PENDING") @db.VarChar(16)
  attemptCount  Int         @default(0) @map("attempt_count")
  expiresAt     DateTime    @map("expires_at")
  resendAfter   DateTime    @map("resend_after")
  usedAt        DateTime?   @map("used_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  verifications OtpVerification[]

  @@index([destinationNormalized, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@map("otp_requests")
}

model OtpVerification {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  otpRequestId  String    @map("otp_request_id") @db.UniqueIdentifier
  tokenHash     String    @unique @map("token_hash") @db.NVarChar(255)
  purpose       String    @db.VarChar(32)
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  otpRequest    OtpRequest @relation(fields: [otpRequestId], references: [id], onDelete: Cascade)

  @@index([purpose, expiresAt])
  @@map("otp_verifications")
}

model RefreshSession {
  id           String    @id @default(uuid()) @db.UniqueIdentifier
  userId       String    @map("user_id") @db.UniqueIdentifier
  tokenHash    String    @unique @map("token_hash") @db.NVarChar(255)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.UniqueIdentifier
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_sessions")
}

model Wallet {
  id           String              @id @default(uuid()) @db.UniqueIdentifier
  userId       String              @unique @map("user_id") @db.UniqueIdentifier
  currency     String              @default("ZENX") @db.VarChar(16)
  balance      BigInt              @default(0)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id              String                    @id @default(uuid()) @db.UniqueIdentifier
  transactionNo   String                    @unique @map("transaction_no") @db.VarChar(40)
  walletId        String                    @map("wallet_id") @db.UniqueIdentifier
  userId          String                    @map("user_id") @db.UniqueIdentifier
  paymentId       String?                   @map("payment_id") @db.UniqueIdentifier
  type            String                    @db.VarChar(16)
  amount          BigInt
  balanceBefore   BigInt                    @map("balance_before")
  balanceAfter    BigInt                    @map("balance_after")
  status          String                    @default("SUCCESS") @db.VarChar(16)
  referenceType   String                    @map("reference_type") @db.VarChar(64)
  referenceId     String                    @map("reference_id") @db.VarChar(255)
  idempotencyKey  String?                   @map("idempotency_key") @db.VarChar(255)
  description     String?                   @db.NVarChar(500)
  createdAt       DateTime                  @default(now()) @map("created_at")
  completedAt     DateTime?                 @map("completed_at")
  wallet          Wallet                    @relation(fields: [walletId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user            User                      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment         Payment?                  @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, idempotencyKey])
  @@map("wallet_transactions")
}

model CoinPackage {
  id         String             @id @default(uuid()) @db.UniqueIdentifier
  code       String             @unique @db.VarChar(32)
  name       String             @db.NVarChar(120)
  priceVnd   BigInt             @map("price_vnd")
  coinAmount BigInt             @map("coin_amount")
  status     String             @default("ACTIVE") @db.VarChar(16)
  sortOrder  Int                @default(0) @map("sort_order")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  payments   Payment[]

  @@index([status, sortOrder])
  @@map("coin_packages")
}

model Payment {
  id                    String             @id @default(uuid()) @db.UniqueIdentifier
  paymentNo             String             @unique @map("payment_no") @db.VarChar(40)
  userId                String             @map("user_id") @db.UniqueIdentifier
  coinPackageId         String             @map("coin_package_id") @db.UniqueIdentifier
  amountVnd             BigInt             @map("amount_vnd")
  coinAmount            BigInt             @map("coin_amount")
  provider              String             @db.VarChar(64)
  paymentMethod         String             @map("payment_method") @db.VarChar(32)
  providerTransactionId String?            @map("provider_transaction_id") @db.VarChar(255)
  idempotencyKey        String?            @map("idempotency_key") @db.VarChar(255)
  providerPayload       String?            @map("provider_payload") @db.NVarChar(4000)
  status                String             @default("CREATED") @db.VarChar(16)
  createdAt             DateTime           @default(now()) @map("created_at")
  paidAt                DateTime?          @map("paid_at")
  expiredAt             DateTime?          @map("expired_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  user                  User               @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coinPackage           CoinPackage        @relation(fields: [coinPackageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  walletTransactions    WalletTransaction[]

  @@index([userId, createdAt])
  @@index([userId, idempotencyKey])
  @@index([status, createdAt])
  @@map("payments")
}
